rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Visitors can see only published documents.
      allow read: if resource.data.published == true ||
        (request.auth != null &&
         request.auth.token.email == "ankusharya7777@gmail.com");

      // Only the THE ABYRON admin account can create, edit or delete.
      allow create, update, delete: if
        request.auth != null &&
        request.auth.token.email == "ankusharya7777@gmail.com";
    }
  }
}
